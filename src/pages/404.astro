---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません" noindex>
  <div class="container measure">
    <header class="page-head">
      <span class="kicker">404</span>
      <h1>ページが見つかりません</h1>
      <p class="lead">移動または削除された可能性があります。</p>
    </header>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">トップへ</a>
      <a class="btn" href="/search/">検索する</a>
      <a class="btn" href="/lessons/">講座一覧</a>
    </div>
  </div>
</Base>
