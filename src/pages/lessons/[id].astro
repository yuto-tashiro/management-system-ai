---
import SoronRef from '../../components/SoronRef.astro';
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import PhaseBadge from '../../components/PhaseBadge.astro';
import LoopChip from '../../components/LoopChip.astro';
import SourceList from '../../components/SourceList.astro';
import WorksheetList from '../../components/WorksheetList.astro';
import BookList from '../../components/BookList.astro';
import LessonCard from '../../components/LessonCard.astro';
import Checklist from '../../components/Checklist.astro';
import { getLessons, lessonHref, lessonsByNos, type Lesson } from '../../lib/content';
import { PHASES, STATUS_LABELS } from '../../data/taxonomy';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson, i) => ({
    params: { id: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1], all: lessons },
  }));
}

interface Props {
  lesson: Lesson;
  prev?: Lesson;
  next?: Lesson;
  all: Lesson[];
}

const { lesson, prev, next, all } = Astro.props;
const d = lesson.data;
const { Content, headings } = await render(lesson);
const nextLessons = lessonsByNos(all, d.next);
const phase = PHASES[d.phase];
---

<Article
  title={`${d.no}　${d.title}`}
  description={d.summary}
  kicker={`講座 ${d.no}｜${phase.label} ${phase.name}`}
  lead={d.summary}
  crumbs={[{ href: '/lessons/', label: '講座一覧' }, { label: `講座${d.no}` }]}
  headings={headings}
  phaseClass={`phase-${d.phase}`}
>
  <Fragment slot="head">
    <dl class="meta-table" style="margin-top: 1.2rem">
      <dt>できるようになること</dt>
      <dd>{d.goal}</dd>
      <dt>対象フェーズ</dt>
      <dd><PhaseBadge phase={d.phase} link withName /></dd>
      <dt>所要時間の目安</dt>
      <dd>{d.duration}</dd>
      <dt>前提</dt>
      <dd>{d.prerequisites}</dd>
      <dt>関連する経営ループ</dt>
      <dd><span class="chips" style="margin:0">{d.loops.map((l) => <LoopChip loop={l} />)}</span></dd>
      <dt>状態</dt>
      <dd>{STATUS_LABELS[d.status]}（{d.version}）｜最終更新 {d.updated}</dd>
    </dl>
  </Fragment>

  <div class="prose">
    <Content />
  </div>

  {
    d.worksheets.length > 0 && (
      <section class="section">
        <h2 id="worksheets">ワークシート</h2>
        <p class="hint">ブラウザ上で記入でき、印刷・Markdownでの書き出しができます。入力内容はこの端末のブラウザにだけ保存されます。</p>
        <WorksheetList ids={d.worksheets} />
      </section>
    )
  }

  <section class="section measure">
    <h2 id="practice-log">実践記録</h2>
    <p class="hint">この講座の完了は、読んだかどうかではなく、手を動かしたかどうかで判断します。</p>
    <Checklist
      storageKey={`lesson-${d.no}`}
      items={[
        '本文を読み、「判断に使う問い」に自分の言葉で答えた',
        'ワークシートを一度書き切った（完成度は問わない）',
        '実際に一つ行動した（面談・提案・改訂・相談など）',
        '結果と学び、次に確かめることを記録した',
      ]}
    />
  </section>

  {
    d.sources.length > 0 && (
      <section class="section measure">
        <h2 id="sources">根拠と出典</h2>
        <p class="hint">
          ラベルの意味は<a href="/about/#evidence">根拠と運営方針</a>を参照。書籍の内容は要旨の言い換えです。
        </p>
        <SourceList sources={d.sources} />
      </section>
    )
  }

  {
    d.books.length > 0 && (
      <section class="section measure">
        <h2 id="books">次に読む文献</h2>
        <BookList ids={d.books} />
      </section>
    )
  }

  {
    nextLessons.length > 0 && (
      <section class="section">
        <h2 id="next">次に読む講座</h2>
        <div class="grid">
          {nextLessons.map((l) => (
            <LessonCard lesson={l} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section measure">
    <h2 id="history">更新履歴</h2>
    <ul>
      <li>{d.updated}　{d.version}：草案を公開。実務での検証前の版です。</li>
    </ul>
  </section>

  <nav class="pager" aria-label="前後の講座">
    {
      prev ? (
        <a href={lessonHref(prev)}>
          <span>← 前の講座 {prev.data.no}</span>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={lessonHref(next)} style="text-align:right">
          <span>次の講座 {next.data.no} →</span>
          {next.data.title}
        </a>
      )
    }
  </nav>

  <Fragment slot="aside">
    <div class="aside-box">
      <h2>このフェーズのガイド</h2>
      <p style="margin:0 0 0.5rem"><PhaseBadge phase={d.phase} link withName /></p>
      <p style="margin:0">{phase.reach}</p>
    </div>
    {
      d.soronChapters.length > 0 && (
        <div class="aside-box">
          <h2>総論との対応</h2>
          <p style="margin:0"><SoronRef chapters={d.soronChapters} /></p>
        </div>
      )
    }
  </Fragment>
</Article>
